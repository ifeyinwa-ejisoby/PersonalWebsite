library(pwr)
pwr.r.test(
n = NULL,                 # number of observations
r = 0.40,                 # linear correlation coefficient
sig.level = 0.05,         # significance level (type I error probability)
power = 0.80,             # power of test (1 minus type II error probability)
alternative = "two.sided" # a character string specifying the-
# alternative hypothesis, must be one of-
# "two.sided" (default), "greater" or "less"
)
sample_size <- pwr.r.test(
n = NULL,                 # number of observations
r = 0.40,                 # linear correlation coefficient
sig.level = 0.05,         # significance level (type I error probability)
power = 0.80,             # power of test (1 minus type II error probability)
alternative = "two.sided" # a character string specifying the-
# alternative hypothesis, must be one of-
# "two.sided" (default), "greater" or "less"
)
sample_size
