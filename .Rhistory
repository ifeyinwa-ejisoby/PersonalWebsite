# age
martinres <- residuals(hivfollowup.demo, type = "martingale")
plot(x=hivfollowup$vage,
y=martinres,
xlab = "Age",
ylab = "Martingale Residual",
main = "Martingale Residuals against Age")
lines(lowess(x=hivfollowup$vage,
y=martinres),
lty=2, col="red")
abline(h=0)
# race
plot(x=factor(hivfollowup$race),
y=martinres,
xlab = "Race",
ylab = "Martingale Residual",
main = "Martingale Residuals against Race")
lines(lowess(x=hivfollowup$race,
y=martinres),
lty=2, col="red")
abline(h=0)
# latino ethnicity
plot(x=factor(hivfollowup$latino),
y=martinres,
xlab = "Latino Ethnicity",
ylab = "Martingale Residual",
main = "Martingale Residuals against Latino Ethnicity")
lines(lowess(x=hivfollowup$vage,
y=martinres),
lty=2, col="red")
abline(h=0)
# country
plot(x=hivfollowup$country,
y=martinres,
xlab = "Country",
ylab = "Martingale Residual",
main = "Martingale Residuals against Country")
lines(lowess(x=hivfollowup$country,
y=martinres),
lty=2, col="red")
abline(h=0)
